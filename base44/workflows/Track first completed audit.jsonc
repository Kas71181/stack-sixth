{
  "name": "Track first completed audit",
  "description": "Records the first completed software audit.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"completed\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "SoftwareAudit"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "track_first_completed_audit",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recordAcquisitionMilestone",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "recordAcquisitionMilestone"
  }
}