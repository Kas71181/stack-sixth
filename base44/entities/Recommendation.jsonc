{
  "name": "Recommendation",
  "type": "object",
  "properties": {
    "audit_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "organization_app_id": {
      "type": "string"
    },
    "recommendation_type": {
      "type": "string",
      "enum": [
        "seat_reclamation",
        "renewal_optimization",
        "usage_verification",
        "contract_review",
        "tool_consolidation"
      ]
    },
    "recommended_action": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Remove Tool",
        "Downgrade Plan",
        "Reclaim Seats",
        "Consolidate Tools",
        "Negotiate Contract",
        "Add Missing Tool"
      ]
    },
    "tool_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "estimated_monthly_savings": {
      "type": "number"
    },
    "financial_impact": {
      "type": "number"
    },
    "financial_impact_status": {
      "type": "string",
      "enum": [
        "SAVINGS_READY_TO_CAPTURE",
        "RENEWAL_SAVINGS_OPPORTUNITY",
        "OPTIMIZATION_CANDIDATE",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "savings_state": {
      "type": "string",
      "enum": [
        "not_realized",
        "ready_to_capture",
        "captured"
      ],
      "default": "not_realized"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "captured_by_user_id": {
      "type": "string"
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_snapshot": {
      "type": "object"
    },
    "source_audit_id": {
      "type": "string"
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "VERIFIED_LIVE",
        "VERIFIED_ACCESS",
        "OBSERVED",
        "FINANCIAL_EVIDENCE",
        "CONTRACT_EVIDENCE",
        "DISCOVERED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "confidence_level": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "insufficient"
      ]
    },
    "calculation_method": {
      "type": "string"
    },
    "last_validated_at": {
      "type": "string",
      "format": "date-time"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "valid",
        "suppressed",
        "stale",
        "requires_revalidation",
        "resolved"
      ],
      "default": "valid"
    },
    "decision_state": {
      "type": "string",
      "enum": [
        "approved",
        "declined",
        "deferred"
      ]
    },
    "decision_reason": {
      "type": "string"
    },
    "defer_option": {
      "type": "string"
    },
    "deferred_until": {
      "type": "string",
      "format": "date"
    },
    "decision_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_by_user_id": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "In Progress",
        "Pending Approval",
        "Completed",
        "Dismissed"
      ],
      "default": "Open"
    },
    "assignee": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tool_name",
    "category"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}