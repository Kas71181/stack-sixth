{
  "name": "ApiCredential",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "title": "Service Name"
    },
    "owner_user_id": {
      "type": "string",
      "title": "Credential Owner User ID"
    },
    "encrypted_payload": {
      "type": "string",
      "title": "Encrypted Credential Payload"
    },
    "encryption_iv": {
      "type": "string",
      "title": "Encryption IV"
    },
    "token_last_four": {
      "type": "string",
      "title": "Token Last Four"
    },
    "encryption_version": {
      "type": "number",
      "default": 1,
      "title": "Encryption Version"
    },
    "api_key": {
      "type": "string",
      "title": "Legacy API Key"
    },
    "extra_fields": {
      "type": "object",
      "title": "Legacy Extra Fields"
    }
  },
  "required": [
    "service"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}