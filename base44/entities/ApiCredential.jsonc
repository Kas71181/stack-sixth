{
  "name": "ApiCredential",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "title": "Service Name (e.g. zoom, apollo, salesforce)"
    },
    "api_key": {
      "type": "string",
      "title": "API Key / Token"
    },
    "extra_fields": {
      "type": "object",
      "title": "Extra Fields (e.g. client_secret, instance_url)"
    }
  },
  "required": [
    "service"
  ]
}