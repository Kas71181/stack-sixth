{
  "name": "ApiCredential",
  "type": "object",
  "properties": {
    "service": {
      "type": "string",
      "title": "Service Name (e.g. zoom, apollo, salesforce)"
    },
    "api_key": {
      "type": "string",
      "title": "API Key / Token"
    },
    "extra_fields": {
      "type": "object",
      "title": "Extra Fields (e.g. client_secret, instance_url)"
    }
  },
  "required": [
    "service"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}