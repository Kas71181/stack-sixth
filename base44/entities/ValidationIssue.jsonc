{
  "name": "ValidationIssue",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "organization_app_id": {
      "type": "string"
    },
    "rule_code": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "warning",
        "error",
        "critical"
      ]
    },
    "message": {
      "type": "string"
    },
    "metric_name": {
      "type": "string"
    },
    "suppressed_value": {
      "type": "string"
    },
    "resolved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "organization_id",
    "rule_code",
    "severity",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}