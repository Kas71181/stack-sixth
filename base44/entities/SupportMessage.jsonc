{
  "name": "SupportMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "user",
        "owner",
        "system"
      ]
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "members",
    "sender_id",
    "sender_role",
    "content"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "data.sender_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}