{
  "name": "PurchaseRequest",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Company ID"
    },
    "requester_user_id": {
      "type": "string",
      "title": "Requester User ID"
    },
    "company_member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Company Member User IDs"
    },
    "company_member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Company Member Emails"
    },
    "company_manager_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Company Manager User IDs"
    },
    "company_manager_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Company Manager Emails"
    },
    "requester_name": {
      "type": "string",
      "title": "Requester Name"
    },
    "requester_email": {
      "type": "string",
      "title": "Requester Email"
    },
    "tool_name": {
      "type": "string",
      "title": "Tool Name"
    },
    "vendor_url": {
      "type": "string",
      "title": "Vendor URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "Communication",
        "Project Management",
        "CRM & Sales",
        "Productivity & Docs",
        "Analytics & BI",
        "Marketing",
        "Customer Support",
        "Identity & Security",
        "Dev Tools",
        "Finance & HR"
      ],
      "title": "Category"
    },
    "estimated_monthly_cost": {
      "type": "number",
      "title": "Requested Cost per Seat/Month"
    },
    "requested_monthly_cost": {
      "type": "number",
      "title": "Requested Total Monthly Cost"
    },
    "approved_monthly_cost": {
      "type": "number",
      "title": "Approved Monthly Cost"
    },
    "actual_purchased_monthly_cost": {
      "type": "number",
      "title": "Actual Purchased Monthly Cost"
    },
    "requested_seats": {
      "type": "number",
      "title": "Requested Seats"
    },
    "team_affected": {
      "type": "string",
      "title": "Team / Department Affected"
    },
    "justification": {
      "type": "string",
      "title": "Business Justification"
    },
    "use_case": {
      "type": "string",
      "title": "Primary Use Case"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "auto_approved",
        "approved",
        "rejected",
        "deferred",
        "provisioned"
      ],
      "default": "pending",
      "title": "Status"
    },
    "execution_state": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "in_progress",
        "completed",
        "verified"
      ],
      "default": "not_started",
      "title": "Execution State"
    },
    "decision_reason": {
      "type": "string",
      "title": "Evaluation Reason"
    },
    "evaluation_evidence": {
      "type": "object",
      "title": "Evaluation Evidence"
    },
    "conflict_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Conflict Flags"
    },
    "redundancy_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Potential Overlap Warnings"
    },
    "budget_status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ],
      "default": "unavailable",
      "title": "Budget Status"
    },
    "budget_impact_pct": {
      "type": "number",
      "title": "Budget Impact (%)"
    },
    "ai_recommendation": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "needs_review"
      ],
      "title": "System Recommendation"
    },
    "reviewer": {
      "type": "string",
      "title": "Reviewer"
    },
    "reviewer_user_id": {
      "type": "string",
      "title": "Reviewer User ID"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Reviewed At"
    },
    "reviewer_note": {
      "type": "string",
      "title": "Reviewer Note"
    },
    "provisioning_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Provisioning Confirmed At"
    },
    "provisioning_confirmed_by_user_id": {
      "type": "string",
      "title": "Provisioning Confirmed By User ID"
    },
    "provisioning_confirmed_by_email": {
      "type": "string",
      "title": "Provisioning Confirmed By Email"
    },
    "provisioned_integration_id": {
      "type": "string",
      "title": "Provisioned Integration ID"
    }
  },
  "required": [
    "tool_name",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "data.company_member_ids": "{{user.id}}"
        },
        {
          "data.company_member_emails": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_manager_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "data.company_manager_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "data.company_manager_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "data.company_manager_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        }
      ]
    }
  }
}