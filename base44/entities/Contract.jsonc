{
  "name": "Contract",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Company ID"
    },
    "canonical_app_id": {
      "type": "string",
      "title": "Canonical Application ID"
    },
    "organization_app_id": {
      "type": "string",
      "title": "Organization Application ID"
    },
    "vendor_name": {
      "type": "string",
      "title": "Vendor Name"
    },
    "contract_name": {
      "type": "string",
      "title": "Contract Name"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "SaaS Subscription",
        "Annual License",
        "Monthly License",
        "Enterprise Agreement",
        "Other"
      ],
      "title": "Contract Type"
    },
    "monthly_cost": {
      "type": "number",
      "title": "Monthly Cost ($)"
    },
    "annual_cost": {
      "type": "number",
      "title": "Annual Cost ($)"
    },
    "last_renewal_date": {
      "type": "string",
      "format": "date",
      "title": "Last Renewal Date"
    },
    "renewal_date": {
      "type": "string",
      "format": "date",
      "title": "Next Renewal Date"
    },
    "notice_deadline": {
      "type": "string",
      "format": "date",
      "title": "Cancellation Notice Deadline"
    },
    "decision_deadline": {
      "type": "string",
      "format": "date",
      "title": "Decision Deadline"
    },
    "billing_frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "annual",
        "unknown"
      ],
      "default": "unknown",
      "title": "Billing Frequency"
    },
    "renewal_source": {
      "type": "string",
      "enum": [
        "contract",
        "manual",
        "gmail",
        "billing",
        "inferred"
      ],
      "default": "inferred",
      "title": "Renewal Source"
    },
    "renewal_source_record_id": {
      "type": "string",
      "title": "Source Record ID"
    },
    "renewal_source_label": {
      "type": "string",
      "title": "Source Label"
    },
    "extraction_method": {
      "type": "string",
      "title": "Extraction Method"
    },
    "source_timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Source Timestamp"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Last Verified"
    },
    "verified_by_user_id": {
      "type": "string",
      "title": "Verified By User ID"
    },
    "verified_by_email": {
      "type": "string",
      "title": "Verified By Email"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "detected",
        "needs_review",
        "customer_confirmed",
        "verified",
        "unknown"
      ],
      "default": "unknown",
      "title": "Verification Status"
    },
    "renewal_confidence": {
      "type": "number",
      "title": "Renewal Confidence (0-100)"
    },
    "needs_confirmation": {
      "type": "boolean",
      "default": true,
      "title": "Needs Confirmation"
    },
    "notice_period_days": {
      "type": "number",
      "title": "Cancellation Notice Period (days)"
    },
    "auto_renews": {
      "type": "boolean",
      "title": "Legacy Auto-Renews"
    },
    "auto_renewal_status": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ],
      "default": "unknown",
      "title": "Auto-Renewal Status"
    },
    "seats_licensed": {
      "type": "number",
      "title": "Seats Licensed"
    },
    "negotiation_leverage": {
      "type": "string",
      "title": "Negotiation Leverage Notes"
    },
    "key_terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Key Terms"
    },
    "file_url": {
      "type": "string",
      "title": "Uploaded File URL"
    },
    "source_fingerprint": {
      "type": "string",
      "title": "Source Fingerprint"
    },
    "evidence_conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Evidence Conflicts"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Expiring Soon",
        "Expired",
        "Cancelled"
      ],
      "default": "Active",
      "title": "Status"
    },
    "decision_state": {
      "type": "string",
      "enum": [
        "undecided",
        "continue",
        "renegotiate",
        "cancel",
        "replace"
      ],
      "default": "undecided",
      "title": "Renewal Decision"
    },
    "action_state": {
      "type": "string",
      "enum": [
        "none",
        "decision_recorded",
        "action_pending",
        "in_progress",
        "completed",
        "verified"
      ],
      "default": "none",
      "title": "Action State"
    },
    "action_type": {
      "type": "string",
      "title": "Requested Action"
    },
    "action_requested_at": {
      "type": "string",
      "format": "date-time",
      "title": "Action Requested At"
    },
    "action_requested_by_user_id": {
      "type": "string",
      "title": "Action Requested By User ID"
    },
    "action_requested_by_email": {
      "type": "string",
      "title": "Action Requested By Email"
    },
    "action_details": {
      "type": "object",
      "title": "Action Details"
    },
    "execution_verified_at": {
      "type": "string",
      "format": "date-time",
      "title": "Execution Verified At"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date-time",
      "title": "Last Reviewed"
    },
    "governance_owner_name": {
      "type": "string",
      "title": "Decision Owner"
    },
    "governance_owner_email": {
      "type": "string",
      "title": "Decision Owner Email"
    },
    "reminder_date": {
      "type": "string",
      "format": "date",
      "title": "Reminder Date"
    },
    "reminder_email_sent": {
      "type": "boolean",
      "default": false,
      "title": "Reminder Email Sent"
    },
    "reminder_dismissed": {
      "type": "boolean",
      "default": false,
      "title": "In-App Reminder Dismissed"
    }
  },
  "required": [
    "vendor_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}