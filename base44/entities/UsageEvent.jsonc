{
  "name": "UsageEvent",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "organization_app_id": {
      "type": "string"
    },
    "canonical_app_id": {
      "type": "string"
    },
    "organization_user_id": {
      "type": "string"
    },
    "canonical_user_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "provider_user_id": {
      "type": "string"
    },
    "provider_app_identifier": {
      "type": "string"
    },
    "provider_event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_connection_id": {
      "type": "string"
    },
    "qualifies_as_activity": {
      "type": "boolean",
      "default": false
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "VERIFIED_LIVE",
        "OBSERVED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "default": "INSUFFICIENT_EVIDENCE"
    },
    "provider_metadata": {
      "type": "object"
    }
  },
  "required": [
    "organization_id",
    "organization_app_id",
    "provider_event_id",
    "occurred_at"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}