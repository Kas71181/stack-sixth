{
  "name": "SyncJob",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "connection_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "cursor": {
      "type": "string"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "rate_limited",
        "revoked"
      ],
      "default": "pending"
    },
    "last_sync_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_successful_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_data_through": {
      "type": "string",
      "format": "date-time"
    },
    "records_processed": {
      "type": "number",
      "default": 0
    },
    "records_created": {
      "type": "number",
      "default": 0
    },
    "records_updated": {
      "type": "number",
      "default": 0
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "organization_id",
    "connection_id",
    "capability"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}