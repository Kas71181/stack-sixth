{
  "name": "ProviderIdentity",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "provider_user_id": {
      "type": "string"
    },
    "canonical_user_id": {
      "type": "string"
    },
    "verified_email": {
      "type": "string",
      "format": "email"
    },
    "identity_type": {
      "type": "string",
      "enum": [
        "human",
        "service_account",
        "bot",
        "integration",
        "external_collaborator",
        "unknown"
      ],
      "default": "unknown"
    },
    "resolution_method": {
      "type": "string",
      "enum": [
        "verified_email",
        "directory",
        "administrator",
        "unresolved"
      ]
    },
    "manually_resolved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "organization_id",
    "provider",
    "provider_user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}