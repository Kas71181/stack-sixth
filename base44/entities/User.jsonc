{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "reminder_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "never"
      ],
      "default": "daily",
      "title": "Email Reminder Frequency"
    }
  },
  "required": [
    "role"
  ]
}