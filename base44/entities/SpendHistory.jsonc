{
  "name": "SpendHistory",
  "type": "object",
  "properties": {
    "period": {
      "type": "string",
      "title": "Period (YYYY-MM)"
    },
    "total_spend": {
      "type": "number",
      "title": "Total Monthly Spend"
    },
    "tool_count": {
      "type": "number",
      "title": "Number of Tools"
    },
    "active_users": {
      "type": "number",
      "title": "Active Users"
    },
    "wasted_spend": {
      "type": "number",
      "title": "Wasted Spend"
    },
    "savings_captured": {
      "type": "number",
      "title": "Savings Captured This Period"
    },
    "snapshot": {
      "type": "array",
      "title": "Tool Breakdown",
      "items": {
        "type": "object",
        "properties": {
          "tool_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "monthly_cost": {
            "type": "number"
          },
          "active_users": {
            "type": "number"
          },
          "licensed_seats": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "period"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}