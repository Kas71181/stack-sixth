{
  "name": "AuditTrailEvent",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Company ID"
    },
    "entity_type": {
      "type": "string",
      "title": "Entity Type"
    },
    "entity_id": {
      "type": "string",
      "title": "Entity ID"
    },
    "entity_label": {
      "type": "string",
      "title": "Human-readable label"
    },
    "action": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "status_changed",
        "assigned",
        "approved",
        "rejected",
        "comment_added",
        "deleted"
      ],
      "title": "Action"
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "USER",
        "SYSTEM",
        "INTEGRATION",
        "AI"
      ],
      "default": "USER",
      "title": "Actor Type"
    },
    "actor_name": {
      "type": "string",
      "title": "Actor"
    },
    "actor_email": {
      "type": "string",
      "title": "Actor Email"
    },
    "old_value": {
      "type": "string",
      "title": "Previous Value"
    },
    "new_value": {
      "type": "string",
      "title": "New Value"
    },
    "note": {
      "type": "string",
      "title": "Note / Comment"
    },
    "source": {
      "type": "string",
      "title": "Event Source"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "action"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}