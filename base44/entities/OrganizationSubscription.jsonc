{
  "name": "OrganizationSubscription",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "FREE_LAUNCH",
        "STARTER",
        "GROWTH",
        "SCALE",
        "ENTERPRISE"
      ]
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "FREE",
        "PROMOTIONAL",
        "INCOMPLETE",
        "TRIALING",
        "ACTIVE",
        "PAST_DUE",
        "CANCELLED",
        "UNPAID",
        "EXPIRED",
        "READ_ONLY",
        "PENDING_PAYMENT"
      ],
      "default": "PENDING_PAYMENT"
    },
    "billing_interval": {
      "type": "string",
      "enum": [
        "none",
        "monthly",
        "annual"
      ],
      "default": "none"
    },
    "trial_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "promotional_access": {
      "type": "boolean",
      "default": false
    },
    "promotional_partner": {
      "type": "string"
    },
    "promotional_campaign": {
      "type": "string"
    },
    "promotional_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "promotional_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_subscription_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_start": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "canceled_at": {
      "type": "string",
      "format": "date-time"
    },
    "past_due_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "NOT_REQUIRED",
        "PENDING",
        "METHOD_ON_FILE",
        "PAID",
        "FAILED",
        "NO_PAYMENT_METHOD"
      ],
      "default": "PENDING"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_checkout_session_id": {
      "type": "string"
    },
    "workspace_mode": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "READ_ONLY"
      ],
      "default": "READ_ONLY"
    }
  },
  "required": [
    "organization_id",
    "owner_user_id",
    "plan",
    "subscription_status",
    "workspace_mode"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}