{
  "name": "SaasIntegration",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Company ID"
    },
    "tool_name": {
      "type": "string",
      "title": "Tool Name"
    },
    "category": {
      "type": "string",
      "enum": [
        "Communication",
        "Project Management",
        "CRM & Sales",
        "Productivity & Docs",
        "Analytics & BI",
        "Marketing",
        "Customer Support",
        "Identity & Security",
        "Dev Tools",
        "Finance & HR"
      ],
      "title": "Category"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "Connected",
        "Evidence",
        "Manual Auth",
        "Manual Upload",
        "Pending",
        "Failed"
      ],
      "default": "Pending",
      "title": "Connection Status"
    },
    "monthly_cost": {
      "type": "number",
      "title": "Monthly Cost ($)"
    },
    "licensed_seats": {
      "type": "number",
      "title": "Licensed Seats"
    },
    "active_users": {
      "type": "number",
      "title": "Active Users"
    },
    "last_synced": {
      "type": "string",
      "format": "date",
      "title": "Last Synced"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "live",
        "access",
        "observed",
        "financial",
        "snapshot",
        "insufficient"
      ],
      "title": "Evidence Type"
    },
    "evidence_file_uri": {
      "type": "string",
      "title": "Private Evidence File URI"
    },
    "evidence_checked_at": {
      "type": "string",
      "format": "date-time",
      "title": "Evidence Checked At"
    },
    "evidence_note": {
      "type": "string",
      "title": "Evidence Note"
    }
  },
  "required": [
    "tool_name",
    "category"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}