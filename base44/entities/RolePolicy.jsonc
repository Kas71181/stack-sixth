{
  "name": "RolePolicy",
  "type": "object",
  "properties": {
    "role_name": {
      "type": "string",
      "title": "Role Name (e.g. Engineer, Sales Rep, HR)"
    },
    "required_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tools this role MUST have"
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tools this role is allowed to have"
    },
    "blocked_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tools this role should NOT have (waste)"
    }
  },
  "required": [
    "role_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}