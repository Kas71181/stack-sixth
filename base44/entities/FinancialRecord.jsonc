{
  "name": "FinancialRecord",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "organization_app_id": {
      "type": "string"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "invoice",
        "billing_api",
        "contract",
        "verified_manual"
      ]
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "billing_period": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "unit_price": {
      "type": "number"
    },
    "marginal_unit_price": {
      "type": "number"
    },
    "minimum_commitment": {
      "type": "number"
    },
    "seat_reduction_changes_spend": {
      "type": "boolean",
      "default": false
    },
    "evidence_id": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_through": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "organization_app_id",
    "record_type",
    "amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}