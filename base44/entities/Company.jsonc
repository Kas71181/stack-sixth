{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Company Name"
    },
    "industry": {
      "type": "string",
      "title": "Industry"
    },
    "employee_count": {
      "type": "number",
      "title": "Employee Count"
    },
    "company_size": {
      "type": "string",
      "enum": [
        "1-9",
        "10-49",
        "50-249",
        "250-999",
        "1000+"
      ]
    },
    "estimated_software_apps": {
      "type": "number"
    },
    "contact_role": {
      "type": "string"
    },
    "contact_first_name": {
      "type": "string"
    },
    "contact_last_name": {
      "type": "string"
    },
    "monthly_saas_budget": {
      "type": "number",
      "title": "Monthly SaaS Budget"
    },
    "audit_score": {
      "type": "number",
      "title": "Audit Score"
    },
    "last_audit_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "fiscal_year_start": {
      "type": "string",
      "default": "January"
    },
    "cost_alert_threshold": {
      "type": "number"
    },
    "notif_weekly_digest": {
      "type": "boolean",
      "default": true
    },
    "notif_inactive_alerts": {
      "type": "boolean",
      "default": true
    },
    "notif_cost_spike": {
      "type": "boolean",
      "default": true
    },
    "notif_renewal_reminders": {
      "type": "boolean",
      "default": true
    },
    "notif_audit_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}