{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Company Name"
    },
    "industry": {
      "type": "string",
      "enum": [
        "SaaS",
        "Agency",
        "E-commerce",
        "Healthcare",
        "Finance",
        "Other"
      ],
      "title": "Industry"
    },
    "employee_count": {
      "type": "number",
      "title": "Employee Count"
    },
    "monthly_saas_budget": {
      "type": "number",
      "title": "Monthly SaaS Budget"
    },
    "audit_score": {
      "type": "number",
      "title": "Audit Score (0-100)"
    },
    "last_audit_date": {
      "type": "string",
      "format": "date",
      "title": "Last Audit Date"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "title": "Currency"
    },
    "fiscal_year_start": {
      "type": "string",
      "default": "January",
      "title": "Fiscal Year Start Month"
    },
    "cost_alert_threshold": {
      "type": "number",
      "title": "Cost Alert Threshold ($)"
    },
    "notif_weekly_digest": {
      "type": "boolean",
      "default": true,
      "title": "Notification: Weekly Digest"
    },
    "notif_inactive_alerts": {
      "type": "boolean",
      "default": true,
      "title": "Notification: Inactive User Alerts"
    },
    "notif_cost_spike": {
      "type": "boolean",
      "default": true,
      "title": "Notification: Cost Spike Alerts"
    },
    "notif_renewal_reminders": {
      "type": "boolean",
      "default": true,
      "title": "Notification: Renewal Reminders"
    },
    "notif_audit_complete": {
      "type": "boolean",
      "default": false,
      "title": "Notification: Audit Complete"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}